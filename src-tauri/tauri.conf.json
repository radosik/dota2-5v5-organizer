{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dota 5v5 Organizer",
  "version": "0.1.1",
  "identifier": "com.rados1k.dota5v5",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dota 2 — 5v5 Organizer",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "rados1k",
    "copyright": "© 2026 rados1k",
    "category": "Utility",
    "shortDescription": "Organize balanced Dota 2 5v5 custom games",
    "longDescription": "Build a roster of players with Steam avatars and Dota ranks pulled from OpenDota, then drag them into two teams and balance the lobby by total MMR.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
